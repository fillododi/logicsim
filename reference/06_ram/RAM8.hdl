// Reference solution for RAM8. Never shown to the player.
CHIP RAM8 {
    IN in[4], addr[3], load;
    OUT out[4];
    PARTS:
    DMux8Way(in=load, sel=addr, a=l0, b=l1, c=l2, d=l3, e=l4, f=l5, g=l6, h=l7);
    Register4(in=in, load=l0, out=r0);
    Register4(in=in, load=l1, out=r1);
    Register4(in=in, load=l2, out=r2);
    Register4(in=in, load=l3, out=r3);
    Register4(in=in, load=l4, out=r4);
    Register4(in=in, load=l5, out=r5);
    Register4(in=in, load=l6, out=r6);
    Register4(in=in, load=l7, out=r7);
    Mux8Way4(a=r0, b=r1, c=r2, d=r3, e=r4, f=r5, g=r6, h=r7, sel=addr, out=out);
}
