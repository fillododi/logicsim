// Reference solution for IndexRegs. Never shown to the player.
CHIP IndexRegs {
    IN in[8], addr[4], load, loadpair, reset;
    OUT out[4], pairout[8];
    PARTS:
    // Which register loads: a pair loads both columns, a register only its own.
    DMux(in=load, sel=addr[0], a=le, b=lo);
    Or(a=le, b=loadpair, out=we);
    Or(a=lo, b=loadpair, out=wo);
    DMux8Way(in=we, sel=addr[1..3], a=we0, b=we1, c=we2, d=we3, e=we4, f=we5, g=we6, h=we7);
    DMux8Way(in=wo, sel=addr[1..3], a=wo0, b=wo1, c=wo2, d=wo3, e=wo4, f=wo5, g=wo6, h=wo7);
    // An even register takes the high half when its whole pair loads; reset loads 0 everywhere.
    Mux4(a=in[0..3], b=in[4..7], sel=loadpair, out=evenpick);
    Mux4(a=evenpick, b=false, sel=reset, out=evenin);
    Mux4(a=in[0..3], b=false, sel=reset, out=oddin);
    Or(a=we0, b=reset, out=l0);
    Or(a=wo0, b=reset, out=l1);
    Or(a=we1, b=reset, out=l2);
    Or(a=wo1, b=reset, out=l3);
    Or(a=we2, b=reset, out=l4);
    Or(a=wo2, b=reset, out=l5);
    Or(a=we3, b=reset, out=l6);
    Or(a=wo3, b=reset, out=l7);
    Or(a=we4, b=reset, out=l8);
    Or(a=wo4, b=reset, out=l9);
    Or(a=we5, b=reset, out=l10);
    Or(a=wo5, b=reset, out=l11);
    Or(a=we6, b=reset, out=l12);
    Or(a=wo6, b=reset, out=l13);
    Or(a=we7, b=reset, out=l14);
    Or(a=wo7, b=reset, out=l15);
    Register4(in=evenin, load=l0, out=r0);
    Register4(in=oddin, load=l1, out=r1);
    Register4(in=evenin, load=l2, out=r2);
    Register4(in=oddin, load=l3, out=r3);
    Register4(in=evenin, load=l4, out=r4);
    Register4(in=oddin, load=l5, out=r5);
    Register4(in=evenin, load=l6, out=r6);
    Register4(in=oddin, load=l7, out=r7);
    Register4(in=evenin, load=l8, out=r8);
    Register4(in=oddin, load=l9, out=r9);
    Register4(in=evenin, load=l10, out=r10);
    Register4(in=oddin, load=l11, out=r11);
    Register4(in=evenin, load=l12, out=r12);
    Register4(in=oddin, load=l13, out=r13);
    Register4(in=evenin, load=l14, out=r14);
    Register4(in=oddin, load=l15, out=r15);
    // Reading: the row picks a pair, addr[0] a register in it.
    Mux8Way4(a=r0, b=r2, c=r4, d=r6, e=r8, f=r10, g=r12, h=r14, sel=addr[1..3], out=even, out=pairout[4..7]);
    Mux8Way4(a=r1, b=r3, c=r5, d=r7, e=r9, f=r11, g=r13, h=r15, sel=addr[1..3], out=odd, out=pairout[0..3]);
    Mux4(a=even, b=odd, sel=addr[0], out=out);
}
