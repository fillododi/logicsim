// Or4Way: every input combination
chip Or4Way
table in     | out
    0b0000 | 0
    0b0001 | 1
    0b0010 | 1
    0b0011 | 1
    0b0100 | 1
    0b0101 | 1
    0b0110 | 1
    0b0111 | 1
    0b1000 | 1
    0b1001 | 1
    0b1010 | 1
    0b1011 | 1
    0b1100 | 1
    0b1101 | 1
    0b1110 | 1
    0b1111 | 1
end
