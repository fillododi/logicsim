// Inc12: edges, a carry stopped or run at every bit, then 16 random rows (seed 4004)
chip Inc12
table in    | out
    0x000 | 0x001
    0x001 | 0x002
    0x002 | 0x003
    0x00E | 0x00F
    0x00F | 0x010
    0x010 | 0x011
    0x0FE | 0x0FF
    0x0FF | 0x100
    0x100 | 0x101
    0xEFF | 0xF00
    0xF00 | 0xF01
    0xFFE | 0xFFF
    0xFFF | 0x000
    0xFFD | 0xFFE
    0xFFB | 0xFFC
    0xFF7 | 0xFF8
    0xFEF | 0xFF0
    0xFDF | 0xFE0
    0xFBF | 0xFC0
    0xF7F | 0xF80
    0xDFF | 0xE00
    0xBFF | 0xC00
    0x7FF | 0x800
    0x003 | 0x004
    0x007 | 0x008
    0x01F | 0x020
    0x03F | 0x040
    0x07F | 0x080
    0x1FF | 0x200
    0x3FF | 0x400
    0xF38 | 0xF39
    0xB5B | 0xB5C
    0x1B6 | 0x1B7
    0xCCA | 0xCCB
    0x0E5 | 0x0E6
    0xE56 | 0xE57
    0x00C | 0x00D
    0xC1C | 0xC1D
    0x6F8 | 0x6F9
    0x7F7 | 0x7F8
    0xCFA | 0xCFB
    0x6C9 | 0x6CA
    0xABF | 0xAC0
    0x766 | 0x767
    0x094 | 0x095
end
